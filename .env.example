# ===========================================
# SafeStop 360 — Environment Configuration (v2, GPS-First)
# Copy relevant sections to backend/.env and frontend/.env
# NEVER commit actual .env files with real secrets.
# ===========================================

# --- Backend (Django) ---
DJANGO_SECRET_KEY=replace-with-a-strong-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: leave blank to use local SQLite (backend/db.sqlite3).
# For PostgreSQL in production (e.g. Render / Supabase / Neon):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=

# CORS & CSRF (comma-separated origins; include https://localhost:5173 if testing HTTPS phone dev)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost:5173

# JWT Lifetimes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Geo Proxy Upstream Services (replace public OSRM/Overpass with self-hosted or commercial in prod)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=SafeStop360/2.0 (ideathon-demo; contact@safestop360.demo)
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
OSRM_BASE_URL=https://router.project-osrm.org

# --- Frontend (Vite) ---
VITE_API_URL=http://127.0.0.1:8000/api
VITE_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
VITE_HTTPS=false
VITE_APP_ENV=development
